            "{PYTHON} {PPIFLOW_ROOT}/pipeline_scripts/convert_cif_flat.py "
            "--input_dir {RESCORE_INPUT_DIR} --output_dir {RESCORE_PDB_DIR} "
            "--sample {RESCORE_SAMPLE}"

    checkpoint rescore_af3score_prepare:
        """Prepare AF3Score JSON inputs and batches for rescoring."""
        input:
            pdb_done=os.path.join(RESCORE_PDB_DIR, ".done")
        output:
            done=touch(os.path.join(AF3SCORE_OUTDIR, "batch", ".prepared"))
        resources:
            mem_mb=8000
