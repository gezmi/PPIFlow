"""PPIFlow Snakemake Workflow

Eight pipeline modes controlled by the target rule:
  snakemake target_denovo               -- de novo nanobody design (single round)
  snakemake target_affinity             -- affinity maturation (no AF3Score)
  snakemake target_full                 -- affinity maturation with AF3Score filtering
  snakemake target_rescore              -- rescore AF3 outputs (AF3Score + Rosetta relax)
  snakemake target_nanobody_full        -- two-round de novo nanobody design (paper B.2)
  snakemake target_binder_full          -- two-round de novo binder design (paper B.1)
  snakemake target_nanobody_metal_full  -- two-round nanobody design, metal-ion-aware
  snakemake target_binder_metal_full    -- two-round binder design, metal-ion-aware

Fully automated: one command in, final ranking out.
AF3 refolding is integrated via Snakemake checkpoint pattern.

Minimal usage:
  snakemake --snakefile workflow/Snakefile \
    --configfile workflow/config_default.yaml \
    --config input_file=/path/to/complex.cif output_dir=/path/to/output \
      af3_home=/path/to/af3 \
    target_affinity
"""

import json
import os

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
PPIFLOW_ROOT = os.path.dirname(workflow.basedir)
PYTHON = os.path.join(PPIFLOW_ROOT, "env", "bin", "python")

# Ensure CUDA and conda env tools (hmmscan etc.) are available on cluster nodes
ENV_BIN = os.path.join(PPIFLOW_ROOT, "env", "bin")
shell.prefix(f"export CUDA_HOME=/apps/easybd/easybuild/amd/software/CUDA/12.1.1 PYTHONNOUSERSITE=1 PATH={ENV_BIN}:$PATH; ")

# Required
OUTDIR     = config["output_dir"]

# Pipeline mode
MODE = config.get("mode", "affinity")
assert MODE in ("denovo", "affinity", "full", "rescore",
                "nanobody_full", "binder_full",
                "nanobody_metal_full", "binder_metal_full",
                "binder_affinity"), \
    (f"Invalid mode '{MODE}'. Must be one of: denovo, affinity, full, rescore, "
     f"nanobody_full, binder_full, nanobody_metal_full, binder_metal_full, binder_affinity.")

# Whether this is a metal-ion-aware two-round pipeline
IS_METAL = MODE in ("nanobody_metal_full", "binder_metal_full")

# input_file is required for all modes except rescore
INPUT_FILE = config.get("input_file", "")
if MODE != "rescore" and not INPUT_FILE:
    raise ValueError("input_file is required for denovo/affinity/full modes")

# Auto-derived defaults
NAME       = config.get("name",
                 os.path.splitext(os.path.basename(INPUT_FILE))[0] if INPUT_FILE else "rescore")
INPUT_TYPE = config.get("input_type",
                 ("cif" if INPUT_FILE.endswith(".cif") else "pdb") if INPUT_FILE else "pdb")

# Chain IDs in the input file (affinity/full modes)
NB_CHAIN  = config.get("nanobody_chain", "B")
REC_CHAIN = config.get("receptor_chain", "A")

# Design parameters
ENERGY_THRESHOLD   = float(config.get("energy_threshold", -5.0))
START_T            = float(config.get("start_t", 0.6))
SAMPLES_PER_TARGET = int(config.get("samples_per_target", 8))
NUM_SEQ_PER_TARGET = int(config.get("num_seq_per_target", 4))
SAMPLING_TEMP      = float(config.get("sampling_temp", 0.1))

# De novo mode parameters
FRAMEWORK_PDB = config.get("framework_pdb",
                    os.path.join(PPIFLOW_ROOT, "Framework",
                                 "7xl0_nanobody_framework.pdb"))
ANTIGEN_CHAIN = config.get("antigen_chain", "C")
HEAVY_CHAIN   = config.get("heavy_chain", "A")
CDR_LENGTH    = config.get("cdr_length", "CDRH1,5-12,CDRH2,4-17,CDRH3,5-26")
HOTSPOTS      = config.get("specified_hotspots") or ""

# Flexible target residues
FLEX_TARGET_RESIDUES = config.get("flexible_target_residues", "")
FLEXIBILITY_SIGMA    = float(config.get("flexibility_sigma", 0.0))
FLEX_SIGMA           = float(config.get("flex_sigma", 0.0))
FLEX_START_T         = float(config.get("flex_start_t", 0.0))

# AF3Score (full and rescore pipelines)
AF3SCORE_DIR       = config.get("af3score_dir", "")
AF3SCORE_MODEL_DIR = config.get("af3score_model_dir",
                         os.path.join(AF3SCORE_DIR, "params") if AF3SCORE_DIR else "")
AF3SCORE_DB_DIR    = config.get("af3score_db_dir",
                         os.path.join(AF3SCORE_DIR, "data") if AF3SCORE_DIR else "")
AF3SCORE_NUM_JOBS  = int(config.get("af3score_num_jobs", 25))
AF3SCORE_PYTHON    = os.path.join(AF3SCORE_DIR, "env", "bin", "python") if AF3SCORE_DIR else PYTHON

# AF3 Refold
AF3_HOME          = config.get("af3_home", "")
AF3_REFOLD_SEEDS  = int(config.get("af3_refold_seeds", 20))
AF3_MODEL_DIR     = config.get("af3_model_dir", "")

# Two-round design parameters (nanobody_full, binder_full, and metal variants)
if MODE in ("nanobody_full", "binder_full", "nanobody_metal_full", "binder_metal_full"):
    DESIGN_TYPE       = "nanobody" if MODE in ("nanobody_full", "nanobody_metal_full") else "binder"
    R1_SAMPLES        = int(config.get("r1_samples_per_target", 100))
    N_GEN_CHUNKS      = int(config.get("n_gen_chunks", 1))
    R1_NUM_SEQ        = int(config.get("r1_num_seq_per_target", 8))
    R1_SAMPLING_TEMP  = config.get("r1_sampling_temp",
                            "0.5" if DESIGN_TYPE == "nanobody" else "0.2")
    R1_IPTM_THRESH    = float(config.get("r1_iptm_threshold", 0.2))
    R2_START_T        = float(config.get("r2_start_t", 0.6))
    R2_SAMPLES        = int(config.get("r2_samples_per_backbone", 8))
    R2_NUM_SEQ        = int(config.get("r2_num_seq_per_target", 4))
    R2_SAMPLING_TEMP  = config.get("r2_sampling_temp", "0.1")
    R2_IPTM_THRESH    = float(config.get("r2_iptm_threshold", 0.5))
    R2_PTM_THRESH     = float(config.get("r2_ptm_threshold", 0.8))
    FINAL_DOCKQ       = float(config.get("final_dockq_threshold", 0.49))
    FINAL_IPTM        = float(config.get("final_iptm_threshold", 0.7))
    FINAL_PTM         = float(config.get("final_ptm_threshold", 0.8))
    FINAL_TOP_N       = int(config.get("final_top_n", 30))
    BINDER_MIN_LEN    = int(config.get("binder_min_length", 50))
    BINDER_MAX_LEN    = int(config.get("binder_max_length", 100))
    HYDRO_BIAS        = json.dumps(
        config.get("hydrophobic_bias", {"F": 0.7, "M": 0.7, "W": 0.7}))
    # FlowPacker (replaces PyRosetta sidechain packing)
    FLOWPACKER_DIR    = config.get("flowpacker_dir", "")
    FLOWPACKER_CKPT   = config.get("flowpacker_ckpt", "cluster.pth")
    CDR_RATIO_THRESH  = float(config.get(
        "cdr_interface_ratio_threshold", 0.6))
    # Rosetta relax method
    RELAX_METHOD      = config.get("relax_method", "interface")
    # LigandMPNN (metal mode only)
    LIGANDMPNN_DIR    = config.get("ligandmpnn_dir", "")
    ION_NAMES         = config.get("ion_names", "ZN MG FE CA MN CU ZN2")
    if IS_METAL and not LIGANDMPNN_DIR:
        raise ValueError("Metal mode requires 'ligandmpnn_dir' in config.")

# ---------------------------------------------------------------------------
# Derived paths (mode-dependent numbering)
# ---------------------------------------------------------------------------
INPUT_PDB = os.path.join(OUTDIR, "00_input", f"{NAME}.pdb")

if MODE == "denovo":
    # denovo: 00_input → 01_denovo → 02_cdr_analysis → 03_abmpnn →
    #         04_sidechain_packing → 05_rosetta_relax →
    #         05_af3_refold → 06_dockq → final_ranking.csv
    BACKBONE_DIR    = os.path.join(OUTDIR, "01_denovo")
    CDR_DIR         = os.path.join(OUTDIR, "02_cdr_analysis")
    ABMPNN_DIR      = os.path.join(OUTDIR, "03_abmpnn")
    PACKED_DIR      = os.path.join(OUTDIR, "04_sidechain_packing")
    RELAX_DIR       = os.path.join(OUTDIR, "05_rosetta_relax")
    AF3_REFOLD_DIR  = os.path.join(OUTDIR, "05_af3_refold")
    DOCKQ_DIR       = os.path.join(OUTDIR, "06_dockq")
elif MODE == "affinity":
    # affinity: 00_input → 01_interface_energy → 02_cdr_analysis →
    #           03_partial_flow → 04_abmpnn → 05_sidechain_packing →
    #           06_rosetta_relax → 07_af3_refold → 08_dockq →
    #           final_ranking.csv
    ENERGY_DIR      = os.path.join(OUTDIR, "01_rosetta_interface")
    CDR_DIR         = os.path.join(OUTDIR, "02_cdr_analysis")
    BACKBONE_DIR    = os.path.join(OUTDIR, "03_partial_flow")
    ABMPNN_DIR      = os.path.join(OUTDIR, "04_abmpnn")
    PACKED_DIR      = os.path.join(OUTDIR, "05_sidechain_packing")
    RELAX_DIR       = os.path.join(OUTDIR, "06_rosetta_relax")
    AF3_REFOLD_DIR  = os.path.join(OUTDIR, "07_af3_refold")
    DOCKQ_DIR       = os.path.join(OUTDIR, "08_dockq")
elif MODE == "full":
    # full: same as affinity but with AF3Score after sidechain_packing
    ENERGY_DIR      = os.path.join(OUTDIR, "01_rosetta_interface")
    CDR_DIR         = os.path.join(OUTDIR, "02_cdr_analysis")
    BACKBONE_DIR    = os.path.join(OUTDIR, "03_partial_flow")
    ABMPNN_DIR      = os.path.join(OUTDIR, "04_abmpnn")
    PACKED_DIR      = os.path.join(OUTDIR, "05_sidechain_packing")
    AF3SCORE_OUTDIR = os.path.join(OUTDIR, "06_af3score")
    RELAX_DIR       = os.path.join(OUTDIR, "07_rosetta_relax")
    AF3_REFOLD_DIR  = os.path.join(OUTDIR, "08_af3_refold")
    DOCKQ_DIR       = os.path.join(OUTDIR, "09_dockq")

elif MODE == "binder_affinity":
    # binder_affinity: 00_input → 01_rosetta_interface →
    #                  02_partial_flow → 03_seqdesign →
    #                  04_sidechain_packing → 05_af3score →
    #                  06_rosetta_relax → 07_af3_refold → 08_dockq →
    #                  final_ranking.csv
    ENERGY_DIR      = os.path.join(OUTDIR, "01_rosetta_interface")
    BACKBONE_DIR    = os.path.join(OUTDIR, "02_partial_flow")
    ABMPNN_DIR      = os.path.join(OUTDIR, "03_seqdesign")
    PACKED_DIR      = os.path.join(OUTDIR, "04_sidechain_packing")
    AF3SCORE_OUTDIR = os.path.join(OUTDIR, "05_af3score")
    RELAX_DIR       = os.path.join(OUTDIR, "06_rosetta_relax")
    AF3_REFOLD_DIR  = os.path.join(OUTDIR, "07_af3_refold")
    DOCKQ_DIR       = os.path.join(OUTDIR, "08_dockq")

elif MODE in ("nanobody_full", "binder_full", "nanobody_metal_full", "binder_metal_full"):
    # Two-round: 00_input → 01_denovo → 01b_filtered → ... → 14_dockq → final_ranking.csv
    DN2_GEN_DIR         = os.path.join(OUTDIR, "01_denovo")
    DN2_FILTER_DIR      = os.path.join(OUTDIR, "01b_filtered_backbones")
    DN2_POS_R1_DIR      = os.path.join(OUTDIR, "02_position_analysis_r1")
    DN2_SEQ_R1_DIR      = os.path.join(OUTDIR, "03_seqdesign_r1")
    DN2_PACK_R1_DIR     = os.path.join(OUTDIR, "04_sidechain_packing_r1")
    DN2_AF3S_R1_DIR     = os.path.join(OUTDIR, "05_af3score_r1")
    DN2_ENRICH_DIR      = os.path.join(OUTDIR, "06_enrichment")
    DN2_PFLOW_DIR       = os.path.join(OUTDIR, "07_partial_flow")
    DN2_POS_R2_DIR      = os.path.join(OUTDIR, "08_position_analysis_r2")
    DN2_SEQ_R2_DIR      = os.path.join(OUTDIR, "09_seqdesign_r2")
    DN2_PACK_R2_DIR     = os.path.join(OUTDIR, "10_sidechain_packing_r2")
    DN2_AF3S_R2_DIR     = os.path.join(OUTDIR, "11_af3score_r2")
    DN2_RELAX_DIR       = os.path.join(OUTDIR, "12_rosetta_relax")
    DN2_AF3_REFOLD_DIR  = os.path.join(OUTDIR, "13_af3_refold")
    DN2_DOCKQ_DIR       = os.path.join(OUTDIR, "14_dockq")
    # Metal mode: ion-copy dirs for LigandMPNN and AF3Score
    if IS_METAL:
        DN2_FILTER_IONS_DIR  = os.path.join(OUTDIR, "01c_filtered_backbones_ions")
        DN2_PACK_R1_IONS_DIR = os.path.join(OUTDIR, "04b_sidechain_packing_r1_ions")
        DN2_PFLOW_IONS_DIR   = os.path.join(OUTDIR, "07b_partial_flow_ions")
        DN2_PACK_R2_IONS_DIR = os.path.join(OUTDIR, "10b_sidechain_packing_r2_ions")

else:  # rescore
    # rescore: CIF→PDB → AF3Score + Rosetta relax → ranking
    RESCORE_INPUT_DIR = config["input_dir"]
    RESCORE_SAMPLE    = config.get("rescore_samples", "top")
    RESCORE_PDB_DIR   = os.path.join(OUTDIR, "00_pdbs")
    AF3SCORE_OUTDIR   = os.path.join(OUTDIR, "01_af3score")
    RELAX_DIR         = os.path.join(OUTDIR, "02_rosetta_relax")

# ===================================================================
# Target rules
# ===================================================================

rule target_denovo:
    """De novo nanobody design → AF3 refold → ranked designs."""
    input:
        os.path.join(OUTDIR, "final_ranking.csv")

rule target_affinity:
    """Affinity maturation → AF3 refold → ranked designs."""
    input:
        os.path.join(OUTDIR, "final_ranking.csv")

rule target_full:
    """Full pipeline with AF3Score → AF3 refold → ranked designs."""
    input:
        os.path.join(OUTDIR, "final_ranking.csv")

rule target_rescore:
    """Rescore AF3 outputs: AF3Score + Rosetta relax → ranked CSV."""
    input:
        os.path.join(OUTDIR, "rescore_ranking.csv")

rule target_binder_affinity:
    """Binder affinity maturation with AF3Score → ranked designs."""
    input:
        os.path.join(OUTDIR, "final_ranking.csv")

rule target_nanobody_full:
    """Two-round de novo nanobody design pipeline."""
    input:
        os.path.join(OUTDIR, "final_ranking.csv")

rule target_binder_full:
    """Two-round de novo binder design pipeline."""
    input:
        os.path.join(OUTDIR, "final_ranking.csv")

rule target_nanobody_metal_full:
    """Two-round de novo nanobody design pipeline (metal-ion-aware)."""
    input:
        os.path.join(OUTDIR, "final_ranking.csv")

rule target_binder_metal_full:
    """Two-round de novo binder design pipeline (metal-ion-aware)."""
    input:
        os.path.join(OUTDIR, "final_ranking.csv")

# ===================================================================
# Mode-specific rules: de novo
# ===================================================================

if MODE == "denovo":
    rule prepare_receptor:
        """Step 0: Copy or rename receptor PDB (ensure antigen is chain C)."""
        input:
            raw=INPUT_FILE
        output:
            pdb=INPUT_PDB
        run:
            os.makedirs(os.path.dirname(output.pdb), exist_ok=True)
            if INPUT_TYPE == "cif":
                shell(
                    f"cd {PPIFLOW_ROOT} && "
                    f"{PYTHON} {PPIFLOW_ROOT}/pipeline_scripts/step01_cif_to_pdb.py "
                    f"--input_cif {input.raw} --output_pdb {output.pdb} "
                    f"--nanobody_chain _ --receptor_chain {ANTIGEN_CHAIN}"
                )
            else:
                # Rename receptor chain to ANTIGEN_CHAIN (default C) to avoid
                # collision with framework chain A
                with open(input.raw) as fin, open(output.pdb, "w") as fout:
                    for line in fin:
                        if line.startswith(("ATOM", "HETATM")):
                            line = line[:21] + ANTIGEN_CHAIN + line[22:]
                        fout.write(line)

    rule denovo_generation:
        """Step 1: De novo nanobody CDR generation [GPU]."""
        input:
            antigen=INPUT_PDB
        output:
            done=touch(os.path.join(BACKBONE_DIR, ".done"))
        resources:
            mem_mb=16000,
            gpu=1
        shell:
            "cd {PPIFLOW_ROOT} && "
            "{PYTHON} {PPIFLOW_ROOT}/sample_antibody_nanobody.py "
            "--antigen_pdb {input.antigen} --antigen_chain {ANTIGEN_CHAIN} "
            "--framework_pdb {FRAMEWORK_PDB} --heavy_chain {HEAVY_CHAIN} "
            "--cdr_length '{CDR_LENGTH}' "
            "--specified_hotspots '{HOTSPOTS}' "
            "--config {PPIFLOW_ROOT}/configs/inference_nanobody.yaml "
            "--samples_per_target {SAMPLES_PER_TARGET} "
            "--model_weights {PPIFLOW_ROOT}/checkpoints/nanobody.ckpt "
            "--flexible_target_residues '{FLEX_TARGET_RESIDUES}' "
            "--flexibility_sigma {FLEXIBILITY_SIGMA} "
            "--flex_sigma {FLEX_SIGMA} --flex_start_t {FLEX_START_T} "
            "--output_dir {BACKBONE_DIR} --name {NAME}"

    rule cdr_analysis_denovo:
        """Step 2: CDR analysis for de novo designs (framework indices only)."""
        input:
            backbone_done=os.path.join(BACKBONE_DIR, ".done")
        output:
            fixed_json=os.path.join(CDR_DIR, "fixed_positions.json"),
            cdr_csv=os.path.join(CDR_DIR, "cdr_idx.csv")
        resources:
            mem_mb=4000
        run:
            import pandas as pd

            os.makedirs(CDR_DIR, exist_ok=True)

            # Extract CDR positions from generated structures
            shell(
                f"cd {PPIFLOW_ROOT} && "
                f"{PYTHON} {PPIFLOW_ROOT}/demo_scripts/get_cdr.py "
                f"{BACKBONE_DIR} {output.cdr_csv}"
            )

            # Framework indices from CDR CSV (no energy-based key contacts)
            fw_indices = []
            cdr_positions = ""
            if os.path.exists(output.cdr_csv):
                df = pd.read_csv(output.cdr_csv)
                if not df.empty:
                    r = df.iloc[0]
                    fw_str = str(r.get("fw_index", ""))
                    fw_indices = fw_str.split() if fw_str else []
                    cdr_positions = str(r.get("r2_cdr_pos", ""))

            fw_nums = sorted({int("".join(c for c in i if c.isdigit()))
                             for i in fw_indices if any(c.isdigit() for c in i)})

            fixed_data = {
                "key_contact_residues": [],
                "partial_flow_fixed": "",
                "cdr_positions": cdr_positions,
                "hotspots": HOTSPOTS,
                "abmpnn_fw_and_key_fixed": " ".join(str(x) for x in fw_nums),
                "fw_indices": fw_indices,
                "key_res_nums": [],
            }
            with open(output.fixed_json, "w") as f:
                json.dump(fixed_data, f, indent=2)

# ===================================================================
# Mode-specific rules: affinity / full (shared initial steps)
# ===================================================================

if MODE in ("affinity", "full", "binder_affinity"):
    rule prepare_input:
        """Step 0: Convert CIF to PDB or rename PDB chains (nanobody→A, receptor→C)."""
        input:
            raw=INPUT_FILE
        output:
            pdb=INPUT_PDB
        run:
            os.makedirs(os.path.dirname(output.pdb), exist_ok=True)
            if INPUT_TYPE == "cif":
                shell(
                    f"cd {PPIFLOW_ROOT} && "
                    f"{PYTHON} {PPIFLOW_ROOT}/pipeline_scripts/step01_cif_to_pdb.py "
                    f"--input_cif {input.raw} --output_pdb {output.pdb} "
                    f"--nanobody_chain {NB_CHAIN} --receptor_chain {REC_CHAIN}"
                )
            elif NB_CHAIN == "A" and REC_CHAIN == "C":
                import shutil
                shutil.copy2(input.raw, output.pdb)
            else:
                import sys
                sys.path.insert(0, os.path.join(PPIFLOW_ROOT, "pipeline_scripts"))
                from pipeline_common import _rename_pdb_chains
                _rename_pdb_chains(input.raw, output.pdb, NB_CHAIN, REC_CHAIN)

    rule interface_energy:
        """Step 1: Per-residue interface energy analysis (PyRosetta)."""
        input:
            pdb=INPUT_PDB
        output:
            energy_csv=os.path.join(ENERGY_DIR, "residue_energy.csv"),
            hotspots=os.path.join(ENERGY_DIR, "hotspots.txt")
        resources:
            mem_mb=8000
        shell:
            "cd {PPIFLOW_ROOT} && "
            "{PYTHON} {PPIFLOW_ROOT}/pipeline_scripts/step02_interface_energy.py "
            "--input_pdb {input.pdb} "
            "--output_dir {ENERGY_DIR} "
            "--binder_chain A --target_chain C "
            "--distance_cutoff 10.0"

if MODE in ("affinity", "full"):
    rule cdr_analysis:
        """Step 2: CDR extraction and fixed position computation."""
        input:
            pdb=INPUT_PDB,
            energy_csv=os.path.join(ENERGY_DIR, "residue_energy.csv"),
            hotspots=os.path.join(ENERGY_DIR, "hotspots.txt")
        output:
            fixed_json=os.path.join(CDR_DIR, "fixed_positions.json"),
            cdr_csv=os.path.join(CDR_DIR, "cdr_idx.csv")
        resources:
            mem_mb=4000
        run:
            import csv as csv_mod
            import pandas as pd

            os.makedirs(CDR_DIR, exist_ok=True)
            input_dir = os.path.dirname(input.pdb)

            # Extract CDR positions
            shell(
                f"cd {PPIFLOW_ROOT} && "
                f"{PYTHON} {PPIFLOW_ROOT}/demo_scripts/get_cdr.py "
                f"{input_dir} {output.cdr_csv}"
            )

            # Key contact residues from energy analysis
            key_residues = []
            with open(input.energy_csv) as f:
                reader = csv_mod.DictReader(f)
                for row in reader:
                    if float(row["binder_energy"]) < ENERGY_THRESHOLD:
                        key_residues.append(row["residue"])

            # Framework indices from CDR CSV
            fw_indices, cdr_positions = [], ""
            if os.path.exists(output.cdr_csv):
                df = pd.read_csv(output.cdr_csv)
                if not df.empty:
                    r = df.iloc[0]
                    fw_str = str(r.get("fw_index", ""))
                    fw_indices = fw_str.split() if fw_str else []
                    cdr_positions = str(r.get("r2_cdr_pos", ""))

            # Read hotspots
            with open(input.hotspots) as f:
                hotspots_str = f.read().strip()

            # Compute fixed positions
            partial_flow_fixed = ",".join(key_residues)
            key_nums = sorted({int("".join(c for c in r if c.isdigit()))
                              for r in key_residues if any(c.isdigit() for c in r)})
            fw_nums = sorted({int("".join(c for c in i if c.isdigit()))
                             for i in fw_indices if any(c.isdigit() for c in i)})
            abmpnn_fixed = sorted(set(fw_nums) | set(key_nums))

            fixed_data = {
                "key_contact_residues": key_residues,
                "partial_flow_fixed": partial_flow_fixed,
                "cdr_positions": cdr_positions,
                "hotspots": hotspots_str,
                "abmpnn_fw_and_key_fixed": " ".join(str(x) for x in abmpnn_fixed),
                "fw_indices": fw_indices,
                "key_res_nums": list(key_nums),
            }
            with open(output.fixed_json, "w") as f:
                json.dump(fixed_data, f, indent=2)

    rule partial_flow:
        """Step 3: Partial flow backbone generation (GPU)."""
        input:
            pdb=INPUT_PDB,
            fixed_json=os.path.join(CDR_DIR, "fixed_positions.json")
        output:
            done=touch(os.path.join(BACKBONE_DIR, ".done"))
        resources:
            mem_mb=16000,
            gpu=1
        run:
            with open(input.fixed_json) as f:
                d = json.load(f)
            shell(
                f"cd {PPIFLOW_ROOT} && "
                f"{PYTHON} {PPIFLOW_ROOT}/sample_antibody_nanobody_partial.py "
                f"--complex_pdb {input.pdb} "
                f"--start_t {START_T} "
                f'--fixed_positions "{d["partial_flow_fixed"]}" '
                f"--antigen_chain C --heavy_chain A "
                f"--config {PPIFLOW_ROOT}/configs/inference_nanobody.yaml "
                f"--samples_per_target {SAMPLES_PER_TARGET} "
                f'--cdr_position "{d["cdr_positions"]}" '
                f'--specified_hotspots "{d["hotspots"]}" '
                f"--retry_Limit 10 "
                f"--model_weights {PPIFLOW_ROOT}/checkpoints/nanobody.ckpt "
                f"--flexible_target_residues '{FLEX_TARGET_RESIDUES}' "
                f"--flexibility_sigma {FLEXIBILITY_SIGMA} "
                f"--flex_sigma {FLEX_SIGMA} --flex_start_t {FLEX_START_T} "
                f"--output_dir {BACKBONE_DIR} "
                f"--name {NAME}"
            )

# ===================================================================
# AF3Score rules (full pipeline only)
# ===================================================================

# AF3Score filter thresholds — ptm_A defaults to 0 in binder_affinity because
# chain A is the target (short peptide), not the designed chain.
IPTM_THRESH  = float(config.get("iptm_threshold", 0.5))
PTM_A_THRESH = float(config.get("ptm_a_threshold",
                                 0.0 if MODE == "binder_affinity" else 0.8))

if MODE in ("full", "binder_affinity"):
    checkpoint af3score_prepare:
        """Prepare AF3Score JSON inputs and batches."""
        input:
            packed_done=os.path.join(PACKED_DIR, ".done")
        output:
            done=touch(os.path.join(AF3SCORE_OUTDIR, "batch", ".prepared"))
        resources:
            mem_mb=8000
        shell:
            "cd {PPIFLOW_ROOT} && "
            "mkdir -p {AF3SCORE_OUTDIR}/json {AF3SCORE_OUTDIR}/batch && "
            "{PYTHON} {PPIFLOW_ROOT}/demo_scripts/flowpacker_af3score/4.1-prepare_get_json.py "
            "--input_dir {PACKED_DIR} "
            "--output_dir_cif {AF3SCORE_OUTDIR}/single_chain_cif "
            "--save_csv {AF3SCORE_OUTDIR}/seq.csv "
            "--output_dir_json {AF3SCORE_OUTDIR}/json "
            "--batch_dir {AF3SCORE_OUTDIR}/batch "
            "--num_jobs {AF3SCORE_NUM_JOBS}"

    rule af3score_jax_batch:
        """Convert PDBs to JAX h5 format for one AF3Score batch (CPU)."""
        input:
            prepared=os.path.join(AF3SCORE_OUTDIR, "batch", ".prepared"),
            batch_json=os.path.join(AF3SCORE_OUTDIR, "batch", "json", "{batch_name}")
        output:
            done=touch(os.path.join(AF3SCORE_OUTDIR, "batch", "h5", "{batch_name}", ".done"))
        resources:
            mem_mb=16000
        shell:
            """
            eval "$('/apps/easybd/programs/miniconda/24.11_environmentally/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
            conda activate {AF3SCORE_DIR}/env
            export JAX_PLATFORM_NAME=cpu
            cd {PPIFLOW_ROOT}
            mkdir -p "{AF3SCORE_OUTDIR}/batch/h5/{wildcards.batch_name}"
            {AF3SCORE_PYTHON} {PPIFLOW_ROOT}/demo_scripts/flowpacker_af3score/4.2_prepare_pdb2jax.py \
                --pdb_folder "{AF3SCORE_OUTDIR}/batch/pdb/{wildcards.batch_name}" \
                --output_folder "{AF3SCORE_OUTDIR}/batch/h5/{wildcards.batch_name}"
            """

    rule af3score_inference_batch:
        """Run AF3Score inference on one batch [GPU]."""
        input:
            jax_done=os.path.join(AF3SCORE_OUTDIR, "batch", "h5", "{batch_name}", ".done")
        output:
            done=touch(os.path.join(AF3SCORE_OUTDIR, "af3score_output", "{batch_name}", ".done"))
        resources:
            mem_mb=32000,
            gpu=1
        shell:
            """
            eval "$('/apps/easybd/programs/miniconda/24.11_environmentally/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
            conda activate {AF3SCORE_DIR}/env
            export CUDA_HOME=/apps/easybd/easybuild/amd/software/CUDA/12.4.0
            export PATH=$CUDA_HOME/bin:$PATH
            cd {PPIFLOW_ROOT}
            export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false --xla_gpu_graph_level=0"
            export XLA_PYTHON_CLIENT_PREALLOCATE=true
            export XLA_CLIENT_MEM_FRACTION=0.90

            mkdir -p "{AF3SCORE_OUTDIR}/af3score_output/{wildcards.batch_name}"
            {AF3SCORE_PYTHON} {PPIFLOW_ROOT}/demo_scripts/flowpacker_af3score/run_af3score.py \
                --db_dir={AF3SCORE_DB_DIR} \
                --model_dir={AF3SCORE_MODEL_DIR} \
                --batch_json_dir="{AF3SCORE_OUTDIR}/batch/json/{wildcards.batch_name}" \
                --batch_h5_dir="{AF3SCORE_OUTDIR}/batch/h5/{wildcards.batch_name}" \
                --output_dir="{AF3SCORE_OUTDIR}/af3score_output/{wildcards.batch_name}" \
                --run_data_pipeline=False \
                --run_inference=true \
                --init_guess=true \
                --num_samples=1 \
                --write_summary_confidences=true \
                --write_full_confidences=true
            """

    def get_af3score_batches(wildcards):
        """Discover batch dirs from checkpoint output and request all inference jobs."""
        checkpoints.af3score_prepare.get(**wildcards)
        batch_json = os.path.join(AF3SCORE_OUTDIR, "batch", "json")
        batches = sorted([d for d in os.listdir(batch_json)
                          if d.startswith("batch_")])
        return expand(os.path.join(AF3SCORE_OUTDIR, "af3score_output", "{b}", ".done"),
                       b=batches)

    rule af3score_metrics:
        """Extract metrics from AF3Score output."""
        input:
            get_af3score_batches
        output:
            csv=os.path.join(AF3SCORE_OUTDIR, "af3score_results.csv")
        resources:
            mem_mb=4000
        shell:
            "cd {PPIFLOW_ROOT} && "
            "{PYTHON} {PPIFLOW_ROOT}/demo_scripts/flowpacker_af3score/easy_get_metrics.py "
            "{AF3SCORE_OUTDIR}/af3score_output "
            "{output.csv}"

    rule af3score_filter:
        """Filter designs by AF3Score metrics (iptm > threshold, optionally ptm_A > threshold)."""
        input:
            csv=os.path.join(AF3SCORE_OUTDIR, "af3score_results.csv"),
            packed_done=os.path.join(PACKED_DIR, ".done")
        output:
            done=touch(os.path.join(AF3SCORE_OUTDIR, "filtered_links", ".done"))
        run:
            import pandas as pd
            import shutil

            df = pd.read_csv(input.csv)
            if PTM_A_THRESH > 0:
                passed = df[(df["iptm"] > IPTM_THRESH) & (df["ptm_A"] > PTM_A_THRESH)]
            else:
                passed = df[df["iptm"] > IPTM_THRESH]

            out_dir = os.path.join(AF3SCORE_OUTDIR, "filtered_links")
            os.makedirs(out_dir, exist_ok=True)
            for _, row in passed.iterrows():
                src = os.path.join(PACKED_DIR, row["description"] + ".pdb")
                if os.path.exists(src):
                    shutil.copy(src, out_dir)
            passed.to_csv(os.path.join(AF3SCORE_OUTDIR, "filtered_results.csv"),
                           index=False)
            print(f"{len(passed)}/{len(df)} designs passed AF3Score filter "
                  f"(iptm>{IPTM_THRESH}"
                  + (f", ptm_A>{PTM_A_THRESH}" if PTM_A_THRESH > 0 else "")
                  + ")")

# ===================================================================
# Rescore mode rules
# ===================================================================

if MODE == "rescore":
    rule convert_cifs:
